root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{kicad_sch,kicad_pcb,kicad_pro,kicad_sym,kicad_mod,net}]
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = tab
